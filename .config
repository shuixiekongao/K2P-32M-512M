  - name: Install build dependencies
    run: |
      sudo apt-get update
      sudo apt-get install -y --no-install-recommends \
        build-essential ccache pkg-config git subversion python3 python3-distutils \
        libncurses5-dev unzip zstd gawk gcc g++ make gettext libssl-dev \
        binutils patch bzip2 ca-certificates rsync realpath

  - name: Clone OpenWrt sources
    run: |
      git clone --depth 1 --branch "${{ github.event.inputs.openwrt_ref }}" https://github.com/openwrt/openwrt.git openwrt || \
        git clone --depth 1 https://github.com/openwrt/openwrt.git openwrt

  - name: Copy .config and files/ into openwrt (if present)
    run: |
      if [ -f "${{ github.workspace }}/.config" ]; then
        cp "${{ github.workspace }}/.config" openwrt/.config
        echo "Copied repo .config into openwrt/.config"
      fi
      if [ -d "${{ github.workspace }}/files" ]; then
        cp -r "${{ github.workspace }}/files" openwrt/
        echo "Copied repo files/ into openwrt/"
      fi

  - name: Add third-party feeds (if script exists)
    if: ${{ always() }}
    run: |
      if [ -f "./scripts/add_kenzo_feeds.sh" ]; then
        chmod +x ./scripts/add_kenzo_feeds.sh
        OPENWRT_DIR=./openwrt ./scripts/add_kenzo_feeds.sh
      else
        echo "No scripts/add_kenzo_feeds.sh found, skipping"
      fi

  - name: Prune .config for 32MB target (ensure minimal set)
    run: |
      chmod +x ./scripts/prune_config.sh
      ./scripts/prune_config.sh ./openwrt
    # prune script will backup openwrt/.config and run make defconfig

  - name: Update and install feeds
    working-directory: openwrt
    run: |
      ./scripts/feeds update -a
      ./scripts/feeds install -a

  - name: Set MAKEFLAGS to -j1
    run: echo "MAKEFLAGS=-j1" >> $GITHUB_ENV

  - name: Create swap (6G) to avoid OOM during build
    run: |
      sudo fallocate -l 6G /swapfile || sudo dd if=/dev/zero of=/swapfile bs=1M count=6144
      sudo chmod 600 /swapfile
      sudo mkswap /swapfile
      sudo swapon /swapfile
      echo "Swap created"
  - name: Show memory/disk before build
    run: free -h && df -h

  - name: Build OpenWrt image (logs saved)
    working-directory: openwrt
    env:
      PROFILE: ${{ github.event.inputs.profile }}
      PACKAGES: ${{ github.event.inputs.packages }}
    run: |
      if [ -f .config ]; then
        echo ".config found, using existing config"
      else
        echo "No .config found; running defconfig first"
        make defconfig
      fi
      time make image PROFILE="${PROFILE}" PACKAGES="${PACKAGES}" V=s 2>&1 | tee ../build.log || true
      echo $? > ../build_exit_code.txt

  - name: Print tail of log for quick debug
    run: |
      echo "==== tail build.log ===="
      tail -n 200 build.log || true
      echo "==== build_exit_code ===="
      cat build_exit_code.txt || true
    continue-on-error: true

  - name: Upload build log
    uses: actions/upload-artifact@v4
    with:
      name: openwrt-build-log
      path: |
        build.log
        build_exit_code.txt

  - name: Upload generated bin/ (artifacts)
    uses: actions/upload-artifact@v4
    with:
      name: openwrt-bin
      path: openwrt/bin || openwrt/bin/targets

  - name: Turn off swap
    if: always()
    run: |
      sudo swapoff /swapfile || true
      sudo rm -f /swapfile || true

  - name: Show final disk / memory
    if: always()
    run: free -h && df -h
